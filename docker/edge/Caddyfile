# The LAN entry point of the llama-swap stack (Dockerfile.edge → ghcr.io/<owner>/llama-swap-edge).
# Runs on the host network in front of llama-swap, which listens on loopback only.
#
#   1. Everything is forwarded to llama-swap, unbuffered (LLM streams, long ComfyUI holds and
#      websockets pass; Caddy sets no read timeout by default).
#   2. ComfyUI auth: llama-swap's `apiKeys` cover /upstream/* as well, so a LAN client must
#      send `Authorization: Bearer <key>` like any other caller. A browser cannot do that on a
#      navigation or a websocket handshake, so for LOOPBACK sources (the owner's
#      `ssh -L 9292:127.0.0.1:9292` tunnel) the edge supplies the header itself and the ComfyUI
#      UI works with no token in the browser. When llama-swap has no keys configured, the
#      injected header is ignored and everything behaves as before.
#   3. Deploy drain: while {$EDGE_STATE}/drain exists (deploy-gate sets it), requests that
#      start new work get 503 + Retry-After. Reads (GET/HEAD/OPTIONS), llama-swap's own /api/*,
#      and ComfyUI hold acks still pass, and requests already in flight are never touched.
#
# The {$VAR:default} placeholders are only overridden by tests/sim, which runs this exact file
# against a real llama-swap on other ports.
{
	admin off
	auto_https off
}

{$EDGE_LISTEN::9292} {
	route {
		@drain_new_work {
			file {
				root {$EDGE_STATE:/state}
				try_files /drain
			}
			not method GET HEAD OPTIONS
			not path /api/*
			not path_regexp ack /comfyui-hold/ack$
		}
		header @drain_new_work Retry-After 60
		respond @drain_new_work "Draining for a deploy: no new work accepted, retry later" 503

		# ComfyUI from loopback: inject the key so the UI works in a browser (see 2 above).
		# Must come before the catch-all proxy below.
		@comfyui_loopback {
			remote_ip 127.0.0.1/32 ::1/128
			path_regexp comfyui_lb ^/(upstream/[^/]*comfyui[^/]*|comfyui)(/|$)
		}
		reverse_proxy @comfyui_loopback {$EDGE_UPSTREAM:127.0.0.1:9293} {
			header_up Authorization "Bearer {$LLAMASWAP_API_KEY:}"
			flush_interval -1
		}

		reverse_proxy {$EDGE_UPSTREAM:127.0.0.1:9293} {
			flush_interval -1
		}
	}
}
